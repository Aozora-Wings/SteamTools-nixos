diff --git a/src/BD.WTTS.Client/Services.Implementation/Platform/Linux/LinuxPlatformServiceImpl.NixOS.cs b/src/BD.WTTS.Client/Services.Implementation/Platform/Linux/LinuxPlatformServiceImpl.NixOS.cs
