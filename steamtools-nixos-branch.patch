+# ============================================================================
+# NixOS 分支构建测试（fork 仓库版 / GitHub Actions）
+#
+# 用途：在 GitHub 网络环境（Azure/NuGet 可达）下验证「官方源码 + NixOS 分支补丁」
+#       可完整构建发布 linux-x64（服务器 nuget 被墙时，本地无法构建，走 CI）。
+# 触发：push nixos-branch 分支自动跑；也可手动 workflow_dispatch。
+# 流程：checkout（补丁已提交在分支）→ 加 NixOSForceRebuild 标记 → 构建发布工具
+#       pub.dll → dotnet pub.dll run --rids linux-x64 → 上传产物。
+# 备注：NixOSForceRebuild 是构建期标记（同服务器发布脚本），让非 NixOS runner
+#       强制走 NixOS 分支发布（目录发布 + 服务式加速器）。
+# ============================================================================
+name: NixOS 分支构建测试
+
+on:
+  push:
+    branches: [nixos-branch]
+    # 只对影响主程序编译的路径触发：src/ 源码、构建配置、workflow 本身。
+    # module.nix / package.nix / flake.nix 是 NixOS 打包配置，改动不参与
+    # 主程序编译，不触发构建；README/文档同样不触发。
+    paths:
+      - 'src/**'
+      - '.github/**'
+      - 'Directory.Build.*'
+      - 'Directory.Packages.props'
+      - 'global.json'
+      - '**/*.props'
+      - '**/*.targets'
+  workflow_dispatch:
+
+jobs:
+  nixos-build:
+    name: 官方源码 + NixOS 补丁 构建发布 linux-x64
+    runs-on: ubuntu-latest
+    timeout-minutes: 120
+    env:
+      # 与服务器发布环境一致：关闭 NuGet 签名验证（官方依赖 Splat 19.3.1 等
+      # 包的作者签名证书已撤销，验证开启会 NU3012 拒绝 restore；服务器脚本同款变量）
+      DOTNET_NUGET_SIGNATURE_VERIFICATION: "false"
+    steps:
+      - name: 检出 nixos-branch（含补丁改动 + 递归子模块）
+        # 必须 submodules: recursive —— CPM（Central Package Management）的
+        # PackageVersion 部分定义在 ref/DirectoryPackages 子模块，不拉则 NU1010
+        # （PackageReference 无对应 PackageVersion）。
+        uses: actions/checkout@v4
+        with:
+          submodules: recursive
+
+      - name: Setup .NET 11 preview SDK（与服务器发布环境同款）
+        uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: '11.0.100-preview.6.26359.118'
+
+      - name: 加 NixOSForceRebuild 构建标记（不进 git，强制 NixOS 分支发布）
+        run: |
+          python3 - <<'PYEOF'
+          p = 'src/BD.WTTS.Client/BD.WTTS.Client.csproj'
+          s = open(p, encoding='utf-8').read()
+          marker = '<!-- nixos-force-rebuild-ci -->'
+          if marker not in s:
+              s = s.replace('<Project Sdk="Microsoft.NET.Sdk">', '<Project Sdk="Microsoft.NET.Sdk">\n  ' + marker, 1)
+          s = s.replace(marker, marker + '\n  <PropertyGroup>\n    <NixOSForceRebuild>1</NixOSForceRebuild>\n  </PropertyGroup>', 1)
+          open(p, 'w', encoding='utf-8').write(s)
+          print('csproj 标记已加')
+          PYEOF
+
+      - name: 注入 NoWarn=NU1605（Avalonia.BuildServices 0.0.29 降级警告忽略——补丁锁定，见邮件附录 5.2）
+        # 补丁锁定 Avalonia.BuildServices 0.0.29（avares 资源编译修复），官方 Avalonia 11.3.20
+        # 依赖 >= 11.3.2 → 全新 restore 报 NU1605 包降级（Warning As Error）。服务器靠缓存绕过，
+        # GitHub 全新缓存会检测到，需在发布命令注入 NoWarn（发布工具同款临时注入，不进 git）。
+        run: |
+          python3 - <<'PYEOF'
+          p = 'src/BD.WTTS.Client.Tools.Publish/Commands/IDotNetPublishCommand.cs'
+          s = open(p, encoding='utf-8').read()
+          old = '        argumentList.Add("--force");\n'
+          new = old + '        argumentList.Add("-p:NoWarn=NU1605");\n'
+          if '-p:NoWarn=NU1605' not in s:
+              assert s.count(old) == 1, f"count={s.count(old)}"
+              s = s.replace(old, new, 1)
+              open(p, 'w', encoding='utf-8').write(s)
+              print('已注入 -p:NoWarn=NU1605')
+          else:
+              print('已存在，跳过')
+          PYEOF
+
+      - name: 全局注入 NoWarn=NU1605（src/Directory.Build.props——覆盖所有项目 restore/build，含插件 build）
+        # 仅注入发布命令不够：PublishPlugins 阶段还会跑 `dotnet build`（插件项目），
+        # 同样触发 Avalonia.BuildServices 0.0.29 降级警告。改为在 src/Directory.Build.props
+        # 全局 NoWarn=NU1605，所有项目（含插件）的 restore/build 全覆盖。CI 临时注入，不进 git。
+        run: |
+          python3 - <<'PYEOF'
+          p = 'src/Directory.Build.props'
+          s = open(p, encoding='utf-8').read()
+          if 'NU1605' not in s:
+              if '</Project>' in s:
+                  s = s.replace('</Project>', '  <PropertyGroup>\n    <NoWarn>$(NoWarn);NU1605</NoWarn>\n  </PropertyGroup>\n</Project>', 1)
+              else:
+                  s += '\n<Project>\n  <PropertyGroup>\n    <NoWarn>$(NoWarn);NU1605</NoWarn>\n  </PropertyGroup>\n</Project>\n'
+              open(p, 'w', encoding='utf-8').write(s)
+              print('已注入 NoWarn=NU1605 到 src/Directory.Build.props')
+          else:
+              print('已存在，跳过')
+          PYEOF
+
+      - name: 构建发布工具 pub.dll
+        run: |
+          dotnet build src/BD.WTTS.Client.Tools.Publish/BD.WTTS.Client.Tools.Publish.csproj -c Release -t:Rebuild -p:UseSharedCompilation=false
+
+      - name: 生成 ShellScript/Linux（官方 build/linux → Publish/ShellScript/Linux）
+        # 官方发布工具（d042131）消费 Publish/ShellScript/Linux 但不在工具内生成；
+        # 官方发布机预置该目录，服务器也靠历史遗留（build/linux 副本，diff 确认 SAME）。
+        # GitHub 全新环境必须先生成，否则 DirectoryNotFoundException。
+        run: |
+          PY=src/BD.WTTS.Client.Avalonia.App/bin/Release/Publish
+          mkdir -p "$PY/ShellScript/Linux"
+          cp -r build/linux/* "$PY/ShellScript/Linux/"
+          echo "== ShellScript/Linux 内容 =="
+          ls "$PY/ShellScript/Linux"
+
+      - name: 模拟 NixOS 发布机（/etc/NIXOS——发布工具所有 NixOS 分支生效）
+        # 发布工具按 File.Exists("/etc/NIXOS") 分支：跳过 bundled dotnet 运行时复制
+        # （isCopyRuntime=false，不产生 dotnet-Runtime/Linux-X64 依赖）、插件目录发布等。
+        # 服务器是 NixOS 天然满足；GitHub runner 需模拟，否则 DirectoryNotFoundException:
+        # Publish/dotnet-Runtime/Linux-X64（发布机预置物，CI 没有）。
+        # 必须 touch 创建文件：.NET 的 File.Exists() 对目录返回 false（mkdir 建的目录不生效），
+        # 只有文件才让 isCopyRuntime=false。服务器 /etc/NIXOS 是 nixos 系统文件，天然满足。
+        run: sudo touch /etc/NIXOS
+
+      - name: 诊断：打印 AcceleratorPage.axaml.cs 20-30 行字节（CS1010 定位）
+        run: |
+          echo '== head 5 =='
+          head -5 src/BD.WTTS.Client.Plugins.Accelerator/UI/Views/Pages/AcceleratorPage.axaml.cs
+          echo '== lines 20-30 =='
+          sed -n '20,30p' src/BD.WTTS.Client.Plugins.Accelerator/UI/Views/Pages/AcceleratorPage.axaml.cs | cat -A
+          echo '== git rev-parse HEAD =='
+          git rev-parse HEAD
+          echo '== git status =='
+          git status --short | head -5
+          echo '== grep wt-ui-debug =='
+          grep -n 'wt-ui-debug' src/BD.WTTS.Client.Plugins.Accelerator/UI/Views/Pages/AcceleratorPage.axaml.cs
+
+      - name: 执行发布（linux-x64，目录发布 + NixOS 适配）
+        run: |
+          cd src/BD.WTTS.Client.Tools.Publish/bin/Release/net11.0
+          dotnet pub.dll run --rids linux-x64
+
+      - name: 上传发布产物
+        uses: actions/upload-artifact@v4
+        with:
+          name: nixos-build-linux-x64
+          path: |
+            src/BD.WTTS.Client.Avalonia.App/bin/Release/Publish/*.tgz
+            src/BD.WTTS.Client.Avalonia.App/bin/Release/Publish/*.json
+          if-no-files-found: warn
+
+      - name: 发布到 GitHub Release 并回填 flake（url + sha256）
+        # 闭环：构建成功 → 上传 Release（固定 tag nixos-build / 固定文件名，URL 稳定）
+        #      → 计算 sha256 → 回填 package.nix 的 publishUrl/publishSha256
+        #      → [skip ci] 提交推送（不触发循环构建）。
+        # 前置：仓库 Actions 需 Read and write 权限（Settings → Actions → Workflow permissions）。
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          set -e
+          TGZ=$(ls src/BD.WTTS.Client.Avalonia.App/bin/Release/Publish/*.tgz | head -1)
+          SHA256=$(sha256sum "$TGZ" | awk '{print $1}')
+          echo "tgz=$TGZ"
+          echo "sha256=$SHA256"
+          cp "$TGZ" Steam++_linux_x64_nixos.tgz
+          # 首次 create，后续 upload --clobber 覆盖同名资产
+          gh release create nixos-build Steam++_linux_x64_nixos.tgz \
+            --title "NixOS 分支自动构建" \
+            --notes "run #${{ github.run_number }} ($(date -u +%Y-%m-%dT%H:%M:%SZ))" \
+            --repo "${{ github.repository }}" 2>/dev/null \
+            || gh release upload nixos-build Steam++_linux_x64_nixos.tgz --clobber \
+            --repo "${{ github.repository }}"
+          # 回填 package.nix（环境变量传入 python，避免 heredoc 展开问题）
+          export PUBLISH_URL="https://github.com/${{ github.repository }}/releases/download/nixos-build/Steam++_linux_x64_nixos.tgz"
+          export PUBLISH_SHA256="$SHA256"
+          python3 - <<'PYEOF'
+          import os, re
+          p = "package.nix"
+          s = open(p, encoding="utf-8").read()
+          s = re.sub(r'publishUrl = ".*";', 'publishUrl = "%s";' % os.environ["PUBLISH_URL"], s, count=1)
+          s = re.sub(r'publishSha256 = ".*";', 'publishSha256 = "%s";' % os.environ["PUBLISH_SHA256"], s, count=1)
+          open(p, "w", encoding="utf-8").write(s)
+          print("package.nix 已回填 publishUrl / publishSha256")
+          print(open(p, encoding="utf-8").read().splitlines()[43:46])
+          PYEOF
+          # [skip ci] 提交推送（不触发循环构建）
+          git config user.name "nixos-ci"
+          git config user.email "nixos-ci@users.noreply.github.com"
+          git add package.nix
+          git commit -m "[skip ci] CI: 自动回填发布包 sha256 ($SHA256)" || echo "package.nix 无变更"
+          git push origin nixos-branch || echo "push 失败（权限不足？请检查 Actions 写权限）"
